# Copy to .env.local and fill in real values. .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ODDS_API_KEY=

# Random secret used to sign session cookies (custom username/PIN auth).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret the odds-sync / score-check Supabase Edge Functions must
# present to prove they're the real cron job, not a public caller.
CRON_SECRET=

# Only needed locally, to run `supabase db push` / `supabase functions deploy`.
# Never used by the app itself and never deployed to Vercel.
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
